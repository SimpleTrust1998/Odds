# Скопіюй у bybit/.env і заповни. Файл .env у git не потрапляє.

# --- Bybit ---
# demo = демо-рахунок Bybit (ключ створюється в режимі Demo Trading), testnet, live = реальні гроші
BYBIT_MODE=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Для реальних грошей обидва рядки нижче обов'язкові
# LIVE_CONFIRM=YES_REAL_MONEY
# Якщо акаунт у Bybit EU — перевір їхній API-домен і вкажи тут
# BYBIT_BASE=https://api.bybit.eu

# --- Стратегія ---
# Пройшли бектест: trend4h (пробій Дончіана), ssl4h (SSL Channel). Решта — лише з ALLOW_UNPROVEN=1:
# hull4h, supertrend4h, squeeze4h, utbot, wavetrend, lorentzian, trend, momentum, scalp, scalp1m, spikeFade, pumpRide
STRATEGY=trend4h
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# SYMBOLS=TOP40   # сканер найліквідніших монет (бектест: гірше, ніж 3 монети)
# ALLOW_UNPROVEN=1

# --- Ризик ---
# safe | normal | aggressive (жорсткі межі: плече ≤10x, ризик ≤3%/угоду, kill-switch ≤35%)
PROFILE=normal
# Необов'язкові уточнення профілю (частки, не відсотки):
# RISK_PCT=0.01
# MAX_LEV=3
# DAILY_LOSS_PCT=0.03
# MAX_DD_PCT=0.15
# MAX_OPEN=2
# Скільки капіталу бот вважає своїм (0 = весь субакаунт)
MAX_CAPITAL_USDT=0
# Абсолютна підлога: якщо капітал нижче — закрити все й зупинитись (напр. 170 при старті з 219)
MIN_EQUITY_USDT=170

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Інше ---
POLL_SEC=20
REPORT_HOUR=9
STATE_DIR=bybit/data
